# Never commit supabase/functions/.env. Set the same values as Supabase project
# secrets before deploying notify-pending-take.
RESEND_API_KEY=re_your-api-key
MODERATOR_EMAIL=you@example.com
HOT_TAKES_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# The Resend onboarding sender works for testing to your own Resend account.
# Verify a domain before sending from a Tricky World address in production.
NOTIFICATION_FROM_EMAIL=Tricky World <onboarding@resend.dev>

# Optional: URL of the Supabase Studio takes table.
MODERATION_URL=https://supabase.com/dashboard/project/your-project-ref/editor
