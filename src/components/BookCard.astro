---
import type { CollectionEntry } from 'astro:content';
import { STATUS_LABELS } from '../lib/reading-status';

interface Props {
  book: CollectionEntry<'books'>['data'];
}

const { book } = Astro.props;
---

<article class="book">
  {book.cover && <img class="cover" src={book.cover} alt="" loading="lazy" width="72" />}
  <div>
    <h2 class="title">{book.title}</h2>
    <p class="author">{book.author}</p>
    <p class="meta">
      <span class:list={['status', `status-${book.status}`]}>{STATUS_LABELS[book.status]}</span>
      {
        book.rating !== undefined && (
          <span class="rating" role="img" aria-label={`Rated ${book.rating} out of 5`}>
            <span class="rating-fill" style={`width: ${(book.rating / 5) * 100}%`}>
              ★★★★★
            </span>
            ★★★★★
          </span>
        )
      }
      {book.yearRead && <span>{book.yearRead}</span>}
    </p>
    {book.genres && <p class="genres">{book.genres.join(' · ')}</p>}
    {book.review && <p class="review">{book.review}</p>}
  </div>
</article>

<style>
  /* --card-accent is set by the parent list. */
  .book {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.15rem;
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--card-accent, var(--accent));
  }

  .cover {
    flex-shrink: 0;
    height: auto;
    border: 1.5px solid var(--line);
    transform: rotate(-2deg);
  }

  .title {
    margin: 0;
    font-size: 1.5rem;
  }

  .author {
    margin: 0.25rem 0 0.6rem;
    color: var(--muted);
    font-family: var(--font-serif);
    font-style: italic;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Rubber-stamp label. */
  .status {
    padding: 0.05rem 0.45rem;
    border: 1.5px solid currentColor;
    border-radius: var(--radius);
    color: var(--fg);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .status-reading {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  /* Two stacked rows of stars: faded underneath, solid clipped to the rating width (supports half stars). */
  .rating {
    position: relative;
    display: inline-block;
    color: color-mix(in srgb, var(--fg) 20%, transparent);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .rating-fill {
    position: absolute;
    inset: 0 auto 0 0;
    overflow: hidden;
    color: var(--fg);
  }

  .genres {
    margin: 0.5rem 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .review {
    margin: 0.5rem 0 0;
    font-family: var(--font-serif);
  }
</style>
