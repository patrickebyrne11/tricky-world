---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Hot Takes" description="Short opinions. Pick a side.">
  <header class="page-intro">
    <p class="eyebrow">Public opinion</p>
    <h1>Hot Takes</h1>
    <h2 id="contribute-heading">Drop your hot takes all over</h2>
    <p>Sign in, send me your take, and I’ll approve it if it’s not like racist or whatever? Then everyone can vote Agree or Disagree.</p>
    <p>Your email will be private.</p>
  </header>

  <div class="takes-app" data-takes-app>
    <section class="account-panel" aria-labelledby="account-heading">
      <h2 id="account-heading">Your account</h2>

      <div data-auth-signed-out>
        <p>Sign in by email to submit a take or vote.</p>
        <form data-auth-form class="inline-form">
          <label for="email">Email</label>
          <div>
            <input id="email" data-auth-email name="email" type="email" autocomplete="email" required />
            <button type="submit">Send sign-in link</button>
          </div>
        </form>
      </div>

      <div data-auth-signed-in hidden>
        <p>Signed in as <strong data-user-email></strong>.</p>
        <button type="button" data-sign-out>Sign out</button>
      </div>
      <p class="form-status" data-auth-status aria-live="polite"></p>
    </section>

    <section class="submit-panel" data-submit-panel hidden aria-labelledby="submit-heading">
      <h2 id="submit-heading">Submit a take</h2>
      <form data-submit-form>
        <label for="take-body">Keep it clear, civil, and under 280 characters.</label>
        <textarea id="take-body" data-take-body name="body" maxlength="280" rows="4" required></textarea>
        <button type="submit">Send for review</button>
      </form>
      <p class="form-status" data-submit-status aria-live="polite"></p>
    </section>

    <section aria-labelledby="board-heading">
      <h2 id="board-heading">The board</h2>
      <p data-list-status aria-live="polite">Loading takes…</p>
      <ul class="takes-list" data-takes-list></ul>
    </section>

    <noscript>
      <p>The live board needs JavaScript because this static site loads current votes from Supabase in your browser.</p>
    </noscript>
  </div>

</BaseLayout>

<script>
  import { mountTakesApp } from '../lib/takes';
  void mountTakesApp();
</script>

<style>
  .page-intro {
    margin-bottom: 2rem;
  }

  .page-intro > p:last-child,
  .account-panel > div > p,
  .contribute p {
    font-family: var(--font-serif);
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.2rem 0 1rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.4rem;
  }

  .takes-app > section,
  .contribute {
    margin-top: 2rem;
  }

  .account-panel,
  .submit-panel,
  .contribute {
    padding: 1rem;
    border: var(--border-width) solid var(--line);
    background: var(--surface);
  }

  form label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .inline-form > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  input,
  textarea,
  button {
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    font: inherit;
  }

  input,
  textarea {
    background: var(--bg);
    color: var(--fg);
  }

  input {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.5rem;
  }

  textarea {
    display: block;
    width: 100%;
    margin-bottom: 0.6rem;
    padding: 0.6rem;
    resize: vertical;
  }

  button {
    padding: 0.45rem 0.75rem;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  button:hover:not(:disabled) {
    border-color: var(--accent);
    background: var(--accent);
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .form-status,
  [data-list-status] {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .takes-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.take-card) {
    padding: 1rem;
    border: var(--border-width) solid var(--line);
    background: var(--surface);
  }

  :global(.take-body) {
    margin: 0 0 1rem;
    font-family: var(--font-serif);
    font-size: 1.2rem;
  }

  :global(.vote-split) {
    display: flex;
    height: 0.65rem;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  :global(.agree-bar) {
    background: var(--teal);
  }

  :global(.disagree-bar) {
    background: var(--rust);
  }

  :global(.vote-numbers) {
    margin: 0.35rem 0 0.75rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  :global(.take-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.take-actions button) {
    padding: 0.45rem 0.75rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: var(--fg);
    color: var(--bg);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  :global(.take-actions button:hover:not(:disabled)) {
    border-color: var(--accent);
    background: var(--accent);
  }

  :global(.take-actions button:disabled) {
    cursor: not-allowed;
    opacity: 0.5;
  }

  :global(.vote-button[aria-pressed='true']) {
    border-color: var(--accent);
    background: var(--accent);
  }

</style>
