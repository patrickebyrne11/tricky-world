---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { READING_STATUSES, STATUS_LABELS } from '../lib/reading-status';

const books = (await getCollection('books'))
  .map((entry) => entry.data)
  .sort(
    (a, b) =>
      READING_STATUSES.indexOf(a.status) - READING_STATUSES.indexOf(b.status) ||
      (b.yearRead ?? 0) - (a.yearRead ?? 0) ||
      a.title.localeCompare(b.title),
  );

const counts = Object.fromEntries(
  READING_STATUSES.map((status) => [status, books.filter((book) => book.status === status).length]),
);
---

<BaseLayout title="Library" description="Books I'm reading, have read, and want to read.">
  <h1>Library</h1>

  <div class="filters" role="group" aria-label="Filter by reading status">
    <button type="button" data-filter="all" aria-pressed="true">All ({books.length})</button>
    {
      READING_STATUSES.map((status) => (
        <button type="button" data-filter={status} aria-pressed="false">
          {STATUS_LABELS[status]} ({counts[status]})
        </button>
      ))
    }
  </div>

  <ul class="book-list">
    {
      books.map((book) => (
        <li data-status={book.status}>
          <BookCard book={book} />
        </li>
      ))
    }
  </ul>

  <p class="empty" hidden>No books match this filter.</p>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const books = document.querySelectorAll<HTMLLIElement>('.book-list > li');
  const emptyMessage = document.querySelector<HTMLParagraphElement>('.empty');

  function applyFilter(filter: string) {
    let visibleCount = 0;

    for (const book of books) {
      const matches = filter === 'all' || book.dataset.status === filter;
      book.hidden = !matches;
      if (matches) visibleCount++;
    }

    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
    }

    if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all'));
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0;
  }

  .filters button {
    padding: 0.3rem 0.8rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .filters button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filters button[aria-pressed='true'] {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }

  .book-list {
    display: grid;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .book-list > li:nth-child(4n + 1) {
    --card-accent: var(--rust);
    --tilt: -0.3deg;
  }

  .book-list > li:nth-child(4n + 2) {
    --card-accent: var(--teal);
    --tilt: 0.2deg;
  }

  .book-list > li:nth-child(4n + 3) {
    --card-accent: var(--mustard);
    --tilt: -0.1deg;
  }

  .book-list > li:nth-child(4n + 4) {
    --card-accent: var(--olive);
    --tilt: 0.35deg;
  }

  /* A fraction of a degree off-square, so the grid looks hand-pasted rather than perfect. */
  .book-list > li {
    transform: rotate(var(--tilt));
  }

  @media (prefers-reduced-motion: no-preference) {
    .book-list > li {
      transition: transform 0.2s ease;
    }

    .book-list > li:hover {
      transform: rotate(0deg);
    }
  }

  .empty {
    color: var(--muted);
  }
</style>
