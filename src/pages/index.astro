---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout>
  <section>
    <h2>Explore</h2>
    <ul class="links">
      <li>
        <a href={url('books')}>Library</a>
        <span>Books read and to read.</span>
      </li>
      <li>
        <a href={url('training')}>Training</a>
        <span>Strava totals.</span>
      </li>
    </ul>
  </section>

  <section>
    <h2>Coming soon</h2>
    <ul class="links soon">
      <li>Writing</li>
      <li>Projects</li>
      <li>Tools</li>
    </ul>
  </section>
</BaseLayout>

<style>
  section + section {
    margin-top: 3rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    color: var(--muted);
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border-width) solid var(--line);
  }

  .links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  .links a,
  .soon li {
    font-family: var(--font-display);
    font-stretch: condensed;
    font-weight: 800;
    font-size: clamp(2rem, 7vw, 3.25rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .links a {
    color: var(--fg);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
  }

  .links span {
    color: var(--muted);
    font-family: var(--font-serif);
    font-style: italic;
  }

  .soon li {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--muted);
  }
</style>
